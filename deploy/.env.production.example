# Copy to deploy/.env.production on the server and fill in. NEVER commit it.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
# MongoDB in Docker on this server (server-setup.sh fills in the password from deploy/.env).
MONGODB_URI=mongodb://restaurant_app:CHANGE_ME@mongo:27017/restaurant_ai?authSource=restaurant_ai
# Allows the non-TLS URI above ONLY because "mongo" is a private Docker hostname (never the internet).
MONGODB_PRIVATE_NETWORK=true
# (Atlas instead: MONGODB_URI=mongodb+srv://... and MONGODB_PRIVATE_NETWORK=false)
MONGODB_DB_NAME=restaurant_ai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_INPUT_COST_MICROS_PER_MTOK=150000
AI_OUTPUT_COST_MICROS_PER_MTOK=600000
AI_DEFAULT_MONTHLY_BUDGET_MICROS=10000000
CORS_ALLOWED_ORIGINS=
ALLOW_PUBLIC_SIGNUP=false
