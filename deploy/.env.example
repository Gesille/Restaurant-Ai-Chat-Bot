# Used by deploy.sh / docker compose (deploy/.env on the server). server-setup.sh creates it
# with random passwords - you normally never edit it. NEVER commit the real file.
# Public hostname served by the host's Caddy (DNS A record -> VPS IP)
API_DOMAIN=api.yourdomain.com
# Host port the API binds on 127.0.0.1. Give every project on the server its own port.
API_PORT=3000
# MongoDB running in Docker next to the API (no port exposed to the internet)
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_DB=restaurant_ai
MONGO_APP_USER=restaurant_app
MONGO_APP_PASSWORD=change-me
